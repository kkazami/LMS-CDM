{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "PGDATABASE",
        "PGHOST_UNPOOLED",
        "PGUSER",
        "POSTGRES_HOST",
        "POSTGRES_PASSWORD",
        "POSTGRES_PRISMA_URL",
        "POSTGRES_URL",
        "POSTGRES_URL_NON_POOLING",
        "POSTGRES_USER",
        "NEON_AUTH_BASE_URL",
        "NEON_PROJECT_ID",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_APP_URL",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASS",
        "SMTP_FROM",
        "TOKEN_ENCRYPTION_KEY",
        "ALLOWED_ORIGINS",
        "TRUSTED_PROXY_IPS",
        "GEMINI_API_KEY",
        "GEMINI_MODEL",
        "GROQ_API_KEY",
        "GROQ_MODEL",
        "OPENAI_API_KEY",
        "DEEPSEEK_API_KEY",
        "AGENT_ROUTER_API_KEY",
        "AGENT_ROUTER_BASE_URL",
        "AGENT_ROUTER_MODEL",
        "JUDGE0_URL",
        "JUDGE0_AUTH_TOKEN",
        "JUDGE0_RAPIDAPI_KEY",
        "RAPIDAPI_KEY",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITHUB_CALLBACK_URL",
        "GITHUB_WEBHOOK_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "SNAPSHOT_DIR",
        "RATE_LIMIT_LOGIN_IP_WINDOW_MS",
        "RATE_LIMIT_LOGIN_IP_MAX",
        "RATE_LIMIT_LOGIN_ACCT_WINDOW_MS",
        "RATE_LIMIT_LOGIN_ACCT_MAX",
        "RATE_LIMIT_REGISTER_WINDOW_MS",
        "RATE_LIMIT_REGISTER_MAX",
        "RATE_LIMIT_PW_RESET_WINDOW_MS",
        "RATE_LIMIT_PW_RESET_MAX",
        "RATE_LIMIT_API_WINDOW_MS",
        "RATE_LIMIT_API_MAX",
        "RATE_LIMIT_UPLOAD_WINDOW_MS",
        "RATE_LIMIT_UPLOAD_MAX",
        "APP_BASE_URL",
        "CRON_SECRET",
        "EMAIL_INVITATIONS_ENABLED",
        "EMAIL_DAILY_LIMIT"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
