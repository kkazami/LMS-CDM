{
  "environment": {
    "kind": "staging", "id": "replace-staging-environment", "origin": "https://staging.example.invalid",
    "syntheticOnly": true, "productionOrigins": ["https://production.example.invalid"]
  },
  "candidateId": "replace-build-or-source-sha",
  "datasetId": "replace-synthetic-dataset-id",
  "output": "tmp/web-quality/load-results.json",
  "limits": { "maxUsers": 1000, "maxDurationSeconds": 3600, "requestTimeoutMs": 35000, "maxRequests": 1000000, "maxResponseBytes": 5242880, "thinkTimeMs": 5000, "rampSeconds": 60 },
  "maxFailureRate": 0.01,
  "allowSyntheticMutations": false,
  "accounts": [
    { "id": "synthetic-student-id", "role": "STUDENT", "sessionEnv": "LMS_LOAD_SESSION_STUDENT_1", "bindings": { "courseId": "synthetic-course-id", "itemId": "synthetic-ungraded-item-id" } },
    { "id": "synthetic-teacher-id", "role": "PROFESSOR", "sessionEnv": "LMS_LOAD_SESSION_TEACHER_1", "bindings": { "courseId": "synthetic-course-id" } },
    { "id": "synthetic-admin-id", "role": "ADMIN", "sessionEnv": "LMS_LOAD_SESSION_ADMIN_1", "bindings": {} }
  ],
  "scenarios": {
    "mixed": [
      { "name": "student-courses", "role": "STUDENT", "method": "GET", "path": "/api/courses?institute=ics&page=1&limit=15", "status": 200, "budget": { "p95Ms": 2000, "p99Ms": 5000 }, "assertions": [{ "pointer": "/courses", "type": "array" }] },
      { "name": "student-classwork", "role": "STUDENT", "method": "GET", "path": "/api/courses/{courseId}/classwork", "status": 200, "budget": { "p95Ms": 2000, "p99Ms": 5000 }, "assertions": [{ "pointer": "/items", "type": "array" }] },
      { "name": "student-notifications", "role": "STUDENT", "method": "GET", "path": "/api/notifications?limit=20", "status": 200, "budget": { "p95Ms": 2000, "p99Ms": 5000 }, "assertions": [{ "pointer": "/notifications", "type": "array" }] },
      { "name": "teacher-gradebook", "role": "PROFESSOR", "method": "GET", "path": "/api/courses/{courseId}/gradebook?page=1", "status": 200, "budget": { "p95Ms": 2000, "p99Ms": 5000 }, "assertions": [{ "pointer": "/students", "type": "array" }] },
      { "name": "admin-terms", "role": "ADMIN", "method": "GET", "path": "/api/admin/terms", "status": 200, "budget": { "p95Ms": 2000, "p99Ms": 5000 }, "assertions": [{ "pointer": "/terms", "type": "array" }] }
    ],
    "deadline": [
      { "name": "submit-and-retry", "role": "STUDENT", "method": "POST", "path": "/api/courses/{courseId}/submissions", "status": 200, "headers": { "Idempotency-Key": "sprint3-deadline-{userId}" }, "body": { "syllabusItemId": "{itemId}", "status": "SUBMITTED", "attachments": [{ "type": "LINK", "url": "https://example.invalid/synthetic", "fileName": "Synthetic answer" }] }, "budget": { "p95Ms": 5000, "p99Ms": 10000 }, "assertions": [{ "pointer": "/success", "equals": true }] }
    ],
    "uploads": [
      { "name": "scanned-synthetic-text", "role": "STUDENT", "method": "POST", "path": "/api/upload", "status": 200, "upload": { "bytes": 10240 }, "budget": { "p95Ms": 10000, "p99Ms": 15000 }, "assertions": [{ "pointer": "/url", "type": "string" }] }
    ],
    "codelab": [
      { "name": "judge0-python", "role": "STUDENT", "method": "POST", "path": "/api/codelab/run", "status": 200, "body": { "sourceCode": "print('synthetic-quality')", "languageId": 71 }, "budget": { "p95Ms": 15000, "p99Ms": 30000 }, "assertions": [{ "pointer": "/stdout", "equals": "synthetic-quality\n" }, { "pointer": "/status/id", "equals": 3 }] }
    ]
  },
  "integrity": [
    { "name": "student-identity", "accountId": "synthetic-student-id", "path": "/api/auth/me", "assertions": [{ "pointer": "/user/id", "equals": "synthetic-student-id" }] }
  ]
}
