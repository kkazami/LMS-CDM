  priority String @default("NORMAL") // "LOW", "NORMAL", "HIGH", "URGENT"

  authorId    String
  instituteId String

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  adminReply String?   @db.Text
