generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Institute {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  createdAt           DateTime             @default(now())
  calendarEvents      CalendarEvent[]
  courses             Course[]
  flashcardDecks      FlashcardDeck[]
  notes               Note[]
  taskItems           TaskItem[]
  users               User[]
  kxPosts             KxPost[]
  programs            AcademicProgram[]
  terms               AcademicTerm[]
  supportTickets      SupportTicket[]
  arenaQuizzes        ArenaQuiz[]
  financialStatements FinancialStatement[]
  businessPlans       BusinessPlan[]
}

model User {
  id                String                  @id @default(cuid())
  name              String
  email             String                  @unique
  password          String?
  googleSubject     String?                 @unique
  firstName         String?
  lastName          String?
  section           String                  @default("")
  activationStatus  AccountActivationStatus @default(ACTIVE)
  activatedAt       DateTime?
  invitationVersion Int                     @default(0)
  uniqueId          String                  @default("") // Employee ID or general identifier
  studentNumber     String?                 @unique
  role              String                  @default("STUDENT") // Roles: "STUDENT", "PROFESSOR" (alias: INSTRUCTOR), "ADMIN"
  isActive          Boolean                 @default(true)
  permissions       String                  @default("[]") // JSON array of permission strings
  securityPin       String? // 6-digit hashed security PIN for step-up MFA
  instituteId       String
  createdAt         DateTime                @default(now())

  // â”€â”€ Profile fields â”€â”€
  avatarUrl   String? // URL to uploaded avatar image (null = initials fallback)
  bio         String  @default("") // Short biography / description
  phone       String  @default("") // Contact phone number
  department  String  @default("") // e.g. "Computer Science", "Business Administration"
  yearLevel   String  @default("") // For students: "1st Year", "2nd Year", etc.
  coverColor  String  @default("#1E88E5") // Profile page banner accent color (hex)
  preferences String  @default("{}") // JSON object storing notification/theme settings

  institute              Institute                @relation(fields: [instituteId], references: [id])
  sessions               Session[]
  notes                  Note[]
  taskItems              TaskItem[]
  calendarEvents         CalendarEvent[]
  taughtCourses          Course[]                 @relation("CourseInstructor")
  enrollments            Enrollment[]
  groupMemberships       StudentGroupMember[]
  announcements          Announcement[]
  sentComments           PrivateComment[]         @relation("CommentSender")
  receivedComments       PrivateComment[]         @relation("CommentRecipient")
  submissions            StudentSubmission[]
  submissionRequests     SubmissionRequest[]
  dashboardLayouts       DashboardLayout[]
  auditLogsAsAdmin       AuditLog[]               @relation("AuditAdmin")
  auditLogsAsTarget      AuditLog[]               @relation("AuditTarget")
  passwordResetOtps      PasswordResetOtp[]
  activationTokens       AccountActivationToken[]
  // â”€â”€â”€ Interactive Activities relations (Sprint 0) â”€â”€â”€
  activityTemplates      ActivityTemplate[]       @relation("ActivityTemplateCreator")
  activitySubmissions    ActivitySubmission[]     @relation("ActivitySubmissions")
  activitySessions       ActivitySession[]        @relation("ActivitySessions")
  gamificationProfile    GamificationProfile?
  flashcardDecks         FlashcardDeck[]          @relation("FlashcardDeckCreator")
  flashcardProgresses    FlashcardProgress[]      @relation("FlashcardProgressUser")
  studySessionLogs       StudySessionLog[]
  materialAnnotations    MaterialAnnotation[]
  notifications          Notification[]
  sentBroadcasts         NotificationBroadcast[]  @relation("BroadcastSender")
  expTransactions        ExpTransaction[]
  createdGradeIncentives GradeIncentiveRule[]     @relation("GradeIncentiveCreator")
  integrityEvents        IntegrityEvent[]         @relation("StudentIntegrityEvents")

  // ─── Knowledge Exchange relations ───
  kxPosts             KxPost[]             @relation("KxPostAuthor")
  kxAnswers           KxAnswer[]           @relation("KxAnswerAuthor")
  kxVerifiedAnswers   KxAnswer[]           @relation("KxAnswerVerifier")
  kxComments          KxComment[]          @relation("KxCommentAuthor")
  kxVotes             KxVote[]             @relation("KxUserVotes")
  kxRevisions         KxRevision[]         @relation("KxRevisionEditor")
  kxReportedFlags     KxFlag[]             @relation("KxFlagReporter")
  kxReviewedFlags     KxFlag[]             @relation("KxFlagReviewer")
  kxBookmarks         KxBookmark[]         @relation("KxUserBookmarks")
  kxFollows           KxFollow[]           @relation("KxUserFollows")
  kxModerationActions KxModerationAction[] @relation("KxModeratorActions")
  kxNotifications     KxNotification[]     @relation("KxUserNotifications")

  // ─── GitHub Integration relations ───
  githubToken       GithubToken?
  githubRepoLinks   GithubRepoLink[]      @relation("UserGithubRepoLinks")
  githubSubmissions GithubSubmission[]    @relation("UserGithubSubmissions")
  githubComments    GithubInlineComment[] @relation("UserGithubInlineComments")

  // ─── Forms Module relations ───
  createdForms                   Form[]                          @relation("FormCreator")
  formAttempts                   FormAttempt[]                   @relation("FormAttempts")
  questionBankItems              QuestionBankItem[]              @relation("QuestionBankCreator")
  credentialProvisioningState    CredentialProvisioningState?
  programMemberships             ProgramMembership[]
  programHeadAssignments         ProgramHeadAssignment[]
  uploadedAssets                 PrivateAsset[]
  supportTickets                 SupportTicket[]                 @relation("UserSupportTickets")
  arenaHostedSessions            ArenaGameSession[]              @relation("ArenaSessionHost")
  arenaParticipations            ArenaParticipant[]              @relation("ArenaUserParticipants")
  arenaAnswers                   ArenaPlayerAnswer[]             @relation("ArenaUserAnswers")
  arenaQuizzes                   ArenaQuiz[]                     @relation("ArenaQuizAuthor")
  financialStatements            FinancialStatement[]            @relation("StudentFinancialStatements")
  businessPlans                  BusinessPlan[]                  @relation("StudentBusinessPlans")
  mockInterviewSavedQuestions    MockInterviewSavedQuestion[]
  mockInterviewApplicantAttempts MockInterviewApplicantAttempt[]
  mockInterviewRecruiterAttempts MockInterviewRecruiterAttempt[]
  mockInterviewQuizAttempts      MockInterviewQuizAttempt[]

  // ─── ITE Participation Tracker relations ───
  activityEvents  ActivityEvent[]  @relation("ActivityEventUser")
  riskAssessments RiskAssessment[] @relation("RiskAssessmentStudent")

  // ─── ITE Practicum relations ───
  practicumPlacements PracticumPlacement[] @relation("PracticumStudent")
  practicumSupervised PracticumPlacement[] @relation("PracticumSupervisor")
  practicumFeedback   PracticumFeedback[]  @relation("PracticumFeedbackAuthor")

  // ─── ITE Focus Mode relations ───
  focusSessions FocusSession[]

  // ─── ITE AI Guidance relations ───
  aiGuidanceRequests AiGuidanceRequest[]

  // ─── ITE Meetings relations ───
  createdMeetings ClassMeeting[] @relation("ClassMeetingCreatedBy")
  meetingJoins    MeetingJoin[]

  @@unique([id, instituteId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @default(cuid())
  userId     String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Course {
  id                  String                     @id @default(cuid())
  code                String
  courseCode          String                     @unique @default("")
  title               String
  section             String                     @default("")
  subject             String                     @default("")
  room                String                     @default("")
  scheduleDays        Int[]                      @default([])
  scheduleStart       String                     @default("")
  scheduleEnd         String                     @default("")
  scheduleStartDate   DateTime?                  @db.Date
  scheduleEndDate     DateTime?                  @db.Date
  description         String                     @default("")
  coverImage          String                     @default("")
  instructorId        String?
  instituteId         String
  isArchived          Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @default(now()) @updatedAt
  termId              String?
  term                AcademicTerm?              @relation(fields: [termId, instituteId], references: [id, instituteId], onDelete: Restrict)
  leaderboardCaches   ActivityLeaderboardCache[]
  activityTemplates   ActivityTemplate[]
  announcements       Announcement[]
  calendarEvents      CalendarEvent[]
  institute           Institute                  @relation(fields: [instituteId], references: [id])
  instructor          User?                      @relation("CourseInstructor", fields: [instructorId], references: [id])
  dashboardLayouts    DashboardLayout[]
  enrollments         Enrollment[]
  flashcardDecks      FlashcardDeck[]
  gradingPolicy       GradingPolicy?
  privateComments     PrivateComment[]
  studentGroups       StudentGroup[]
  studySessions       StudySessionLog[]
  syllabusItems       SyllabusItem[]
  taskItems           TaskItem[]
  weeklyChallenges    WeeklyChallenge[]
  broadcasts          NotificationBroadcast[]
  gradeIncentiveRules GradeIncentiveRule[]
  kxPosts             KxPost[]
  arenaQuizzes        ArenaQuiz[]
  forms               Form[]
  questionBankItems   QuestionBankItem[]

  // ─── ITE Participation Tracker relations ───
  activityEvents  ActivityEvent[]  @relation("ActivityEventCourse")
  riskAssessments RiskAssessment[] @relation("RiskAssessmentCourse")

  // ─── ITE Focus Mode relations ───
  focusSessions FocusSession[]

  // ─── ITE AI Guidance relations ───
  aiGuidanceRequests AiGuidanceRequest[]

  // ─── ITE Meetings relations ───
  meetings  ClassMeeting[]
  programId String?
  program   AcademicProgram? @relation(fields: [programId, instituteId], references: [id, instituteId], onDelete: Restrict)

  @@unique([instituteId, termId, code, section])
  @@index([instituteId])
  @@index([instructorId])
}

model Enrollment {
  id                String   @id @default(cuid())
  courseId          String
  studentId         String
  status            String   @default("PENDING")
  displayOrderIndex Int      @default(0)
  createdAt         DateTime @default(now())
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId, status])
  @@index([studentId])
}

model SyllabusItem {
  id                        String                @id @default(cuid())
  courseId                  String
  type                      String                @default("MATERIAL")
  title                     String
  description               String                @default("")
  dueDate                   DateTime?
  maxPoints                 Int?
  orderIndex                Int                   @default(0)
  leaderboardEnabled        Boolean               @default(false)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @default(now()) @updatedAt
  attachments               Attachment[]
  submissions               StudentSubmission[]
  studySessions             StudySessionLog[]
  enableIntegrityMonitoring Boolean               @default(false)
  requireFullscreen         Boolean               @default(false)
  integrityEvents           IntegrityEvent[]
  course                    Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  targetGroups              SyllabusTargetGroup[]
  kxPosts                   KxPost[]
  githubSubmissions         GithubSubmission[]
  leaderboardRewards        LeaderboardReward[]
  form                      Form?

  @@index([courseId, type])
  @@index([courseId, orderIndex])
}

model StudentGroup {
  id            String                @id @default(cuid())
  courseId      String
  groupName     String
  createdAt     DateTime              @default(now())
  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members       StudentGroupMember[]
  targetedItems SyllabusTargetGroup[]

  @@index([courseId])
}

model StudentGroupMember {
  id        String       @id @default(cuid())
  groupId   String
  studentId String
  group     StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
}

model SyllabusTargetGroup {
  id             String       @id @default(cuid())
  syllabusItemId String
  groupId        String
  group          StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  syllabusItem   SyllabusItem @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)

  @@unique([syllabusItemId, groupId])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("ANNOUNCEMENT") // "ANNOUNCEMENT" | "GRADE" | "CLASSWORK" | "REMINDER" | "ALERT" | "BROADCAST"
  title     String
  message   String
  link      String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model NotificationBroadcast {
  id             String   @id @default(cuid())
  courseId       String
  senderId       String
  message        String
  category       String   @default("GENERAL") // "REMINDER" | "ALERT" | "GENERAL"
  scope          String   @default("ALL") // "ALL" or JSON array of student IDs
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sender         User     @relation("BroadcastSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@index([senderId])
}

model PrivateComment {
  id          String   @id @default(cuid())
  courseId    String
  senderId    String
  recipientId String
  content     String
  sentiment   String?
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recipient   User     @relation("CommentRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("CommentSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([courseId, recipientId])
  @@index([senderId])
}

model Attachment {
  id             String               @id @default(cuid())
  syllabusItemId String
  type           String               @default("FILE")
  url            String
  fileName       String               @default("")
  fileSize       Int?
  createdAt      DateTime             @default(now())
  syllabusItem   SyllabusItem         @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  annotations    MaterialAnnotation[]

  @@index([syllabusItemId])
}

model StudentSubmission {
  id              String                 @id @default(cuid())
  syllabusItemId  String
  studentId       String
  status          String                 @default("DRAFT")
  grade           Float?
  isReturned      Boolean                @default(false)
  submittedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @default(now()) @updatedAt
  student         User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  syllabusItem    SyllabusItem           @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  attachments     SubmissionAttachment[]
  integrityEvents IntegrityEvent[]
  githubRepoLinks GithubRepoLink[]

  @@unique([syllabusItemId, studentId])
  @@index([syllabusItemId])
  @@index([studentId])
}

model SubmissionRequest {
  id          String   @id
  userId      String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SubmissionAttachment {
  id           String            @id @default(cuid())
  submissionId String
  type         String            @default("FILE")
  url          String
  fileName     String            @default("")
  createdAt    DateTime          @default(now())
  submission   StudentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model DashboardLayout {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  displayOrderIndex Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model Note {
  id          String    @id @default(cuid())
  title       String    @default("")
  content     String    @default("")
  category    String    @default("General")
  color       String    @default("#ffffff")
  pinned      Boolean   @default(false)
  archived    Boolean   @default(false)
  orderIndex  Int       @default(0)
  creatorId   String
  instituteId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, creatorId])
  @@index([instituteId, archived, pinned, orderIndex])
}

model TaskItem {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  priority    String    @default("medium")
  dueDate     DateTime?
  courseId    String?
  completed   Boolean   @default(false)
  archived    Boolean   @default(false)
  orderIndex  Int       @default(0)
  creatorId   String
  instituteId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course?   @relation(fields: [courseId], references: [id])
  creator     User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, creatorId])
  @@index([instituteId, completed, orderIndex])
}

model CalendarEvent {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  professorName String    @default("")
  maxPoints     Int?
  eventDate     DateTime
  endDate       DateTime?
  eventType     String    @default("assignment")
  deepLink      String    @default("#")
  courseId      String?
  creatorId     String
  instituteId   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  course        Course?   @relation(fields: [courseId], references: [id])
  creator       User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  institute     Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, eventDate])
  @@index([instituteId, creatorId])
}

model GradingPolicy {
  id        String           @id @default(cuid())
  courseId  String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  weights   CategoryWeight[]
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CategoryWeight {
  id               String        @id @default(cuid())
  gradingPolicyId  String
  category         String
  weightPercentage Float
  gradingPolicy    GradingPolicy @relation(fields: [gradingPolicyId], references: [id], onDelete: Cascade)

  @@unique([gradingPolicyId, category])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  targetId  String
  action    String
  ipAddress String   @default("")
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  admin     User     @relation("AuditAdmin", fields: [adminId], references: [id])
  target    User     @relation("AuditTarget", fields: [targetId], references: [id])

  @@index([adminId])
  @@index([targetId])
  @@index([createdAt])
}

model PasswordResetOtp {
  id          String   @id @default(cuid())
  userId      String
  otpCodeHash String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// â”€â”€â”€ Interactive Activities Models (Sprint 0) â”€â”€â”€
// These tables support the ICS-exclusive Interactive Activities feature suite:
// 3D hardware simulations (PC building, Arduino/IoT, server racks, logic gates)
// and the multi-language auto-graded CodeLab.

/// Instructor-defined problem template that drives activity randomization.
/// Each template defines a "problem shape" with variables substituted per-student.
model ActivityTemplate {
  id               String               @id @default(cuid())
  activityType     String
  title            String               @default("Interactive Activity")
  courseId         String
  syllabusItemId   String?
  difficulty       Int                  @default(1)
  variables        String               @default("{}")
  faultPool        String               @default("[]")
  hiddenTestCases  String               @default("[]")
  createdBy        String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  sessions         ActivitySession[]
  submissions      ActivitySubmission[]
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator          User                 @relation("ActivityTemplateCreator", fields: [createdBy], references: [id])
  weeklyChallenges WeeklyChallenge[]

  @@index([courseId, activityType])
  @@index([createdBy])
}

/// Student submission record for a completed activity attempt.
/// Contains the full grading payload so the activity can be graded
/// without replaying the 3D scene.
model ActivitySubmission {
  id                    String           @id @default(cuid())
  studentId             String
  templateId            String
  activityType          String
  variantSeed           String
  startedAt             DateTime
  completionTimeSeconds Int
  attempts              Int              @default(1)
  stateCheck            String           @default("{}")
  score                 Float            @default(0)
  maxScore              Float            @default(100)
  passed                Boolean          @default(false)
  errorLog              String           @default("[]")
  submittedAt           DateTime         @default(now())
  student               User             @relation("ActivitySubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  template              ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([studentId, activityType])
  @@index([templateId])
  @@index([submittedAt])
}

/// Registry of 3D model assets used by activity modules.
/// Tracks paths, versions, and Draco compression status.
model ActivityAsset {
  id                String   @id @default(cuid())
  path              String   @unique
  name              String
  version           String   @default("1.0.0")
  isDracoCompressed Boolean  @default(true)
  activityTypes     String   @default("[]")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

/// Tracks an in-progress activity attempt before submission.
/// Created when a student opens an activity, finalized on submit or timeout.
model ActivitySession {
  id          String           @id @default(cuid())
  studentId   String
  templateId  String
  variantSeed String
  status      String           @default("in_progress")
  startedAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  student     User             @relation("ActivitySessions", fields: [studentId], references: [id], onDelete: Cascade)
  template    ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([templateId])
}

model GamificationProfile {
  id                      String    @id @default(cuid())
  studentId               String    @unique
  currentStreak           Int       @default(0)
  longestStreak           Int       @default(0)
  lastActivityDate        DateTime?
  totalPoints             Int       @default(0)
  isLeaderboardAnonymized Boolean   @default(false)
  publicLeaderboardOptIn  Boolean   @default(true)

  // ── EXP & Level ──
  exp       Int    @default(0) // Current total EXP
  level     Int    @default(1) // Current level (1–60+)
  levelTier String @default("newcomer") // newcomer | bronze | silver | gold | platinum | diamond | master | legend

  // ── Login Streak Rewards ──
  lastLoginDate      DateTime? // Date of last login (date only, compare by day)
  loginStreakCurrent Int       @default(0) // Consecutive daily logins
  loginStreakLongest Int       @default(0) // All-time longest login streak
  totalLoginDays     Int       @default(0) // Total unique days logged in
  lastDailyRewardAt  DateTime? // When the daily reward was last claimed

  // ── Grade Incentive ──
  gradeIncentiveBonusExp Int @default(0) // Accumulated EXP from instructor grade incentives

  student User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badges  StudentBadge[]
}

model StudentBadge {
  id          String              @id @default(cuid())
  profileId   String
  badgeRuleId String
  earnedAt    DateTime            @default(now())
  isNew       Boolean             @default(true) // True until student views the badge notification
  notifiedAt  DateTime? // When the badge-earned toast was shown
  profile     GamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, badgeRuleId])
}

model ExpTransaction {
  id             String   @id @default(cuid())
  userId         String
  idempotencyKey String?
  amount         Int // Positive = gain, Negative = deduction
  reason         String // Human-readable: "Completed CodeLab Level 5", "Daily Login Streak (Day 7)"
  source         String // "codelab" | "assignment" | "attendance" | "login" | "grade_incentive" | "badge" | "study_timer"
  courseId       String? // If tied to a course
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([source])
}

model GradeIncentiveRule {
  id                String   @id @default(cuid())
  courseId          String
  createdBy         String // Instructor userId
  label             String // e.g. "Perfect Score Bonus", "Passing Grade Reward"
  gradeMin          Float // Minimum grade to qualify (0–100)
  bonusExp          Int // EXP awarded when threshold is met
  rewardDescription String   @default("") // Custom freeform reward text (e.g. "Certificate of Excellence", "+5 on final grade")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator           User     @relation("GradeIncentiveCreator", fields: [createdBy], references: [id])

  @@index([courseId])
}

model LeaderboardReward {
  id             String       @id @default(cuid())
  syllabusItemId String
  placement      Int // e.g. 1, 3, 5, 10 — "Top N"
  rewardLabel    String // e.g. "+5 bonus points on final grade", "Certificate of Excellence"
  bonusExp       Int          @default(0) // Optional EXP alongside custom reward
  createdAt      DateTime     @default(now())
  syllabusItem   SyllabusItem @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)

  @@index([syllabusItemId])
}

model ActivityLeaderboardCache {
  id           String   @id @default(cuid())
  courseId     String?
  activityType String?
  rankings     String   @default("[]")
  updatedAt    DateTime @default(now()) @updatedAt
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, activityType])
}

model WeeklyChallenge {
  id         String           @id @default(cuid())
  courseId   String
  templateId String
  startDate  DateTime
  endDate    DateTime
  isOptIn    Boolean          @default(true)
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  template   ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model FlashcardDeck {
  id          String      @id @default(cuid())
  title       String
  description String      @default("")
  tags        String      @default("[]")
  color       String      @default("#6366f1")
  courseId    String?
  creatorId   String
  instituteId String
  isArchived  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  cards       Flashcard[]
  course      Course?     @relation(fields: [courseId], references: [id])
  creator     User        @relation("FlashcardDeckCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  institute   Institute   @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, creatorId])
  @@index([courseId])
}

model Flashcard {
  id          String              @id @default(cuid())
  deckId      String
  front       String
  back        String
  hint        String              @default("")
  attachments String              @default("[]")
  orderIndex  Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deck        FlashcardDeck       @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress    FlashcardProgress[]

  @@index([deckId, orderIndex])
}

model FlashcardProgress {
  id             String    @id @default(cuid())
  cardId         String
  userId         String
  status         String    @default("unseen")
  attemptCount   Int       @default(0)
  correctCount   Int       @default(0)
  lastAnswer     String    @default("")
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  card           Flashcard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user           User      @relation("FlashcardProgressUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
}

model StudySessionLog {
  id              String        @id @default(cuid())
  userId          String
  courseId        String?
  syllabusItemId  String?
  durationSeconds Int
  startedAt       DateTime
  completedAt     DateTime
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  syllabusItem    SyllabusItem? @relation(fields: [syllabusItemId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model MaterialAnnotation {
  id               String     @id @default(cuid())
  userId           String
  attachmentId     String
  quote            String
  noteContent      String     @default("")
  color            String     @default("yellow")
  positionMetadata String     @default("{}")
  createdAt        DateTime   @default(now())
  attachment       Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, attachmentId])
}

// ─── Quiz & Activity Anti-Cheating Integrity Monitoring ───
model IntegrityEvent {
  id             String   @id @default(cuid())
  studentId      String
  syllabusItemId String
  submissionId   String?
  eventType      String // "TAB_SWITCH" | "COPY_PASTE" | "FULLSCREEN_EXIT" | "RIGHT_CLICK"
  severity       String   @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH"
  metadata       String   @default("{}") // JSON payload (e.g. details, duration)
  timestamp      DateTime @default(now())

  student      User               @relation("StudentIntegrityEvents", fields: [studentId], references: [id], onDelete: Cascade)
  syllabusItem SyllabusItem       @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  submission   StudentSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([syllabusItemId, studentId])
  @@index([syllabusItemId, timestamp])
  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────
// ─── Knowledge Exchange (KX) Q&A Models (ICS Exclusive) ──────
// ─────────────────────────────────────────────────────────────

model KxPost {
  id             String   @id @default(cuid())
  title          String
  body           String
  postType       String   @default("QUESTION") // "QUESTION" | "DISCUSSION"
  status         String   @default("OPEN") // "OPEN" | "ANSWERED" | "CLOSED" | "LOCKED"
  isAnonymous    Boolean  @default(false)
  authorId       String
  instituteId    String
  courseId       String?
  syllabusItemId String?
  viewCount      Int      @default(0)
  voteCount      Int      @default(0)
  answerCount    Int      @default(0)
  isPinned       Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  closeReason    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author       User          @relation("KxPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  institute    Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  syllabusItem SyllabusItem? @relation(fields: [syllabusItemId], references: [id], onDelete: SetNull)

  answers           KxAnswer[]
  comments          KxComment[]
  tags              KxPostTag[]
  votes             KxVote[]
  revisions         KxRevision[]
  flags             KxFlag[]
  bookmarks         KxBookmark[]
  follows           KxFollow[]
  moderationActions KxModerationAction[]
  githubRepoLinks   GithubRepoLink[]

  @@index([instituteId, createdAt])
  @@index([instituteId, status])
  @@index([authorId])
  @@index([courseId])
  @@index([syllabusItemId])
  @@index([isPinned, createdAt])
}

model KxAnswer {
  id           String   @id @default(cuid())
  postId       String
  authorId     String
  body         String
  isAnonymous  Boolean  @default(false)
  isAccepted   Boolean  @default(false)
  isVerified   Boolean  @default(false)
  verifiedById String?
  voteCount    Int      @default(0)
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  post       KxPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author     User   @relation("KxAnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  verifiedBy User?  @relation("KxAnswerVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  comments KxComment[]
  votes    KxVote[]
  flags    KxFlag[]

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([isAccepted])
  @@index([isVerified])
}

model KxComment {
  id          String   @id @default(cuid())
  postId      String?
  answerId    String?
  authorId    String
  body        String
  isAnonymous Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post   KxPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  answer KxAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)
  author User      @relation("KxCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  flags KxFlag[]

  @@index([postId])
  @@index([answerId])
  @@index([authorId])
}

model KxTag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @default("")
  category    String   @default("TOPIC") // "CPE" | "IT" | "GENERAL" | "TOPIC"
  postCount   Int      @default(0)
  createdAt   DateTime @default(now())

  posts   KxPostTag[]
  follows KxFollow[]

  @@index([category])
  @@index([postCount])
}

model KxPostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String

  post KxPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  KxTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([tagId])
  @@index([postId])
}

model KxVote {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  answerId  String?
  value     Int // 1 for upvote, -1 for downvote
  createdAt DateTime @default(now())

  user   User      @relation("KxUserVotes", fields: [userId], references: [id], onDelete: Cascade)
  post   KxPost?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  answer KxAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, answerId])
  @@index([postId])
  @@index([answerId])
  @@index([userId])
}

model KxRevision {
  id        String   @id @default(cuid())
  postId    String
  editorId  String
  title     String
  body      String
  summary   String   @default("")
  createdAt DateTime @default(now())

  post   KxPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  editor User   @relation("KxRevisionEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([editorId])
}

model KxFlag {
  id           String    @id @default(cuid())
  reporterId   String
  postId       String?
  answerId     String?
  commentId    String?
  reason       String // "SPAM" | "OFFENSIVE" | "CHEATING" | "OFF_TOPIC" | "OTHER"
  description  String    @default("")
  status       String    @default("PENDING") // "PENDING" | "REVIEWED" | "DISMISSED" | "ACTIONED"
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  reporter   User       @relation("KxFlagReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("KxFlagReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  post       KxPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  answer     KxAnswer?  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  comment    KxComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([postId])
  @@index([answerId])
  @@index([commentId])
}

model KxBookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User   @relation("KxUserBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  post KxPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}

model KxFollow {
  id        String   @id @default(cuid())
  userId    String
  tagId     String?
  postId    String?
  createdAt DateTime @default(now())

  user User    @relation("KxUserFollows", fields: [userId], references: [id], onDelete: Cascade)
  tag  KxTag?  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  post KxPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@unique([userId, postId])
  @@index([userId])
  @@index([tagId])
  @@index([postId])
}

model KxModerationAction {
  id          String   @id @default(cuid())
  moderatorId String
  actionType  String // "CLOSE" | "REOPEN" | "LOCK" | "UNLOCK" | "PIN" | "UNPIN" | "DELETE" | "RESTORE"
  targetType  String // "POST" | "ANSWER" | "COMMENT"
  targetId    String
  postId      String?
  reason      String   @default("")
  createdAt   DateTime @default(now())

  moderator User    @relation("KxModeratorActions", fields: [moderatorId], references: [id], onDelete: Cascade)
  post      KxPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([moderatorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model KxNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "ANSWER" | "COMMENT" | "ACCEPTED" | "VERIFIED" | "UPVOTE" | "MENTION" | "WEEKLY_DIGEST"
  title     String
  message   String
  link      String   @default("")
  isRead    Boolean  @default(false)
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation("KxUserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// ─── GitHub Integration Models (Knowledge Exchange) ──────────
// ─────────────────────────────────────────────────────────────

model GithubToken {
  id             String    @id @default(cuid())
  userId         String    @unique
  encryptedToken String
  scope          String
  connectedAt    DateTime  @default(now())
  lastUsedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GithubRepoLink {
  id           String   @id @default(cuid())
  userId       String
  postId       String?
  submissionId String?
  owner        String
  repo         String
  branch       String   @default("main")
  commitSha    String?
  filePath     String?
  lineStart    Int?
  lineEnd      Int?
  visibility   String   @default("cohort") // "cohort" | "instructor_only" | "anonymous"
  linkedAt     DateTime @default(now())

  user              User                  @relation("UserGithubRepoLinks", fields: [userId], references: [id], onDelete: Cascade)
  post              KxPost?               @relation(fields: [postId], references: [id], onDelete: SetNull)
  submission        StudentSubmission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  comments          GithubInlineComment[]
  ciResults         GithubCiResult[]
  githubSubmissions GithubSubmission[]

  @@index([postId])
  @@index([userId])
  @@index([submissionId])
  @@index([owner, repo])
}

model GithubSubmission {
  id             String   @id @default(cuid())
  syllabusItemId String
  userId         String
  repoLinkId     String
  commitSha      String
  submittedAt    DateTime @default(now())
  snapshotPath   String?
  isLate         Boolean  @default(false)
  attemptNumber  Int      @default(1)

  syllabusItem  SyllabusItem           @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  user          User                   @relation("UserGithubSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  repoLink      GithubRepoLink         @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)
  similaritiesA SubmissionSimilarity[] @relation("SimilaritySubmissionA")
  similaritiesB SubmissionSimilarity[] @relation("SimilaritySubmissionB")

  @@unique([syllabusItemId, userId, attemptNumber])
  @@index([syllabusItemId])
  @@index([userId])
  @@index([repoLinkId])
}

model GithubInlineComment {
  id              String   @id @default(cuid())
  repoLinkId      String
  authorId        String
  filePath        String
  lineNumber      Int
  body            String
  githubCommentId BigInt?
  parentId        String?
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  repoLink GithubRepoLink        @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)
  author   User                  @relation("UserGithubInlineComments", fields: [authorId], references: [id], onDelete: Cascade)
  parent   GithubInlineComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  GithubInlineComment[] @relation("CommentReplies")

  @@index([repoLinkId, filePath])
  @@index([authorId])
  @@index([parentId])
}

model GithubWebhookEvent {
  id           String   @id @default(cuid())
  deliveryId   String   @unique
  eventType    String
  repoFullName String
  payload      String // JSON stringified payload
  processed    Boolean  @default(false)
  receivedAt   DateTime @default(now())

  @@index([deliveryId])
  @@index([repoFullName])
  @@index([processed])
}

model GithubCiResult {
  id           String   @id @default(cuid())
  repoLinkId   String
  commitSha    String
  workflowName String?
  status       String // "success" | "failure" | "pending" | "cancelled"
  conclusion   String?
  runUrl       String?
  fetchedAt    DateTime @default(now())

  repoLink GithubRepoLink @relation(fields: [repoLinkId], references: [id], onDelete: Cascade)

  @@index([repoLinkId, commitSha])
}

model SubmissionSimilarity {
  id            String   @id @default(cuid())
  submissionAId String
  submissionBId String
  score         Float // 0.00 to 100.00
  flagged       Boolean  @default(false)
  checkedAt     DateTime @default(now())

  submissionA GithubSubmission @relation("SimilaritySubmissionA", fields: [submissionAId], references: [id], onDelete: Cascade)
  submissionB GithubSubmission @relation("SimilaritySubmissionB", fields: [submissionBId], references: [id], onDelete: Cascade)

  @@index([submissionAId])
  @@index([submissionBId])
}

// ─────────────────────────────────────────────────────────────
// ─── LMS Forms & Google Forms Assessment Suite ───────────────
// ─────────────────────────────────────────────────────────────

model Form {
  id             String @id @default(cuid())
  courseId       String
  syllabusItemId String @unique
  createdBy      String
  title          String
  description    String @default("")
  formType       String // "QUIZ" | "MIDTERM_EXAM" | "FINAL_EXAM" | "ACTIVITY"
  status         String @default("DRAFT") // "DRAFT" | "PUBLISHED" | "CLOSED" | "ARCHIVED"

  // Availability & Timing
  opensAt       DateTime?
  closesAt      DateTime?
  timeLimitMins Int?

  // Attempt Rules
  maxAttempts Int    @default(1)
  scoreToKeep String @default("HIGHEST") // "HIGHEST" | "LATEST" | "AVERAGE"

  // Presentation & Order
  shuffleQuestions Boolean @default(false)
  shuffleOptions   Boolean @default(false)

  // Feedback & Visibility
  showScoreAfter    Boolean @default(true)
  showAnswersAfter  Boolean @default(false)
  showFeedbackAfter Boolean @default(false)

  // Exam Security & Proctoring
  isProctored      Boolean @default(false)
  passwordHash     String?
  disableCopyPaste Boolean @default(false)
  detectTabSwitch  Boolean @default(false)
  lockBrowser      Boolean @default(false)

  // Grading Metrics
  totalPoints  Float?
  passingScore Float?

  // Customization & Confirmation
  confirmationMessage String?
  themeColor          String?
  headerImageUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  syllabusItem SyllabusItem   @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  creator      User           @relation("FormCreator", fields: [createdBy], references: [id])
  sections     FormSection[]
  questions    FormQuestion[]
  attempts     FormAttempt[]

  @@index([courseId, status])
  @@index([createdBy])
}

model FormSection {
  id          String  @id @default(cuid())
  formId      String
  title       String?
  description String?
  position    Int     @default(0)
  pageNumber  Int     @default(1)

  form      Form           @relation(fields: [formId], references: [id], onDelete: Cascade)
  questions FormQuestion[]

  @@index([formId, position])
}

model FormQuestion {
  id            String  @id @default(cuid())
  formId        String
  sectionId     String?
  bankItemId    String?
  questionType  String // "MULTIPLE_CHOICE" | "CHECKBOXES" | "SHORT_ANSWER" | "PARAGRAPH" | "DROPDOWN" | "LINEAR_SCALE" | "STAR_RATING" | "DATE" | "FILE_UPLOAD" | "MATRIX" | "RANKING" | "IMAGE_CHOICE" | "CODE_ANSWER" | "SECTION_HEADER"
  prompt        String
  description   String?
  mediaUrl      String?
  mediaType     String? // "IMAGE" | "VIDEO" | "AUDIO"
  position      Int     @default(0)
  isRequired    Boolean @default(true)
  points        Float   @default(1)
  partialCredit Boolean @default(false)

  // Type-specific options and validation stored as JSON string
  config String @default("{}")

  // Branching / Conditional logic
  showIfQuestionId String?
  showIfAnswer     String?

  // Text length boundaries
  minLength Int?
  maxLength Int?

  createdAt DateTime @default(now())

  form     Form                @relation(fields: [formId], references: [id], onDelete: Cascade)
  section  FormSection?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  bankItem QuestionBankItem?   @relation(fields: [bankItemId], references: [id], onDelete: SetNull)
  answers  FormAttemptAnswer[]

  dependentQuestions FormQuestion[] @relation("QuestionBranching")
  parentQuestion     FormQuestion?  @relation("QuestionBranching", fields: [showIfQuestionId], references: [id], onDelete: SetNull)

  @@index([formId, position])
  @@index([sectionId])
}

model QuestionBankItem {
  id           String   @id @default(cuid())
  courseId     String?
  createdBy    String
  questionType String
  prompt       String
  config       String   @default("{}")
  points       Float    @default(1)
  tags         String   @default("[]") // JSON string array of tags
  timesUsed    Int      @default(0)
  createdAt    DateTime @default(now())

  course    Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  creator   User           @relation("QuestionBankCreator", fields: [createdBy], references: [id])
  questions FormQuestion[]

  @@index([courseId])
  @@index([createdBy])
  @@index([questionType])
}

model FormAttempt {
  id            String @id @default(cuid())
  formId        String
  userId        String
  attemptNumber Int    @default(1)
  status        String @default("IN_PROGRESS") // "IN_PROGRESS" | "SUBMITTED" | "TIMED_OUT" | "ABANDONED"

  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  timeSpentSecs Int?
  deadlineAt    DateTime?

  // Auto-computed scores
  rawScore    Float?
  totalPoints Float?
  percentage  Float?
  passed      Boolean?

  // Gradebook synchronization status
  syncedToGradebook Boolean   @default(false)
  syncedAt          DateTime?

  // Exam integrity metrics
  tabSwitchCount Int     @default(0)
  copyPasteCount Int     @default(0)
  ipAddress      String?
  userAgent      String?

  form    Form                @relation(fields: [formId], references: [id], onDelete: Cascade)
  user    User                @relation("FormAttempts", fields: [userId], references: [id], onDelete: Cascade)
  answers FormAttemptAnswer[]

  @@unique([formId, userId, attemptNumber])
  @@index([formId, status])
  @@index([userId])
}

model FormAttemptAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  // Storage per answer type
  answerText    String?
  answerOptions String? // JSON array of selected string IDs
  answerNumber  Float?
  answerDate    DateTime?
  answerRanking String? // JSON array of ordered string IDs
  answerMatrix  String? // JSON object of key-value row/column map
  fileUrl       String?
  fileName      String?
  fileSizeBytes Int?

  // Evaluation & Grading
  isCorrect        Boolean?
  pointsAwarded    Float?
  autoGraded       Boolean  @default(false)
  instructorGraded Boolean  @default(false)
  feedback         String?

  answeredAt DateTime @default(now())

  attempt  FormAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

/// Granular activity event log used by the ITE Participation Tracker.
/// Records every real LMS action taken by an ITE student so engagement
/// scores can be computed from authentic data rather than heuristics.
/// Non-ITE users are never written here (enforced in logActivity helper).
model ActivityEvent {
  id        String            @id @default(cuid())
  userId    String
  courseId  String?
  type      ActivityEventType
  /// Optional reference to the triggering entity (syllabusItemId, deckId, etc.)
  refId     String?
  createdAt DateTime          @default(now())

  user   User    @relation("ActivityEventUser", fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation("ActivityEventCourse", fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([userId, courseId, type, refId])
}

enum ActivityEventType {
  LOGIN
  COURSE_VIEW
  MATERIAL_VIEW
  TASK_SUBMITTED
  QUIZ_ATTEMPT
  FLASHCARD_REVIEW
  MEETING_JOIN
  ANNOUNCEMENT_READ
}

/// Cached risk assessment per (student, course) pair for ITE courses.
/// Recomputed by the nightly cron scan and the on-demand "Recalculate now" button.
/// Unique on [studentId, courseId] — one row per pair, upserted on each scan.
model RiskAssessment {
  id               String     @id @default(cuid())
  studentId        String
  courseId         String
  level            RiskLevel
  riskScore        Int // 0–100; higher = more at-risk
  engagementScore  Int // 0–100; higher = more engaged
  /// JSON array of { code: string, label: string, detail: string }
  reasons          Json
  computedAt       DateTime   @default(now())
  lastAlertedAt    DateTime?
  lastAlertedLevel RiskLevel?

  student User   @relation("RiskAssessmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation("RiskAssessmentCourse", fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId, level])
  @@index([studentId])
  @@index([computedAt])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

