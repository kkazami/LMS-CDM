  question MockInterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
  @@index([studentId])
  @@index([questionId])
}

model MockInterviewApplicantAttempt {
  id                  String   @id @default(cuid())
  studentId           String
  questionId          String
  writtenAnswer       String   @db.Text
  checklistAssessment Json     @default("{}")
  feedbackNotes       String?  @db.Text
  createdAt           DateTime @default(now())

  student  User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question MockInterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([questionId])
}

model MockInterviewRecruiterAttempt {
  id                      String   @id @default(cuid())
  studentId               String
  scenarioId              String
  selectedQuestionId      String
  classifiedAnswer        String
  selectedFollowUpId      String?
  isQuestionCorrect       Boolean  @default(false)
  isClassificationCorrect Boolean  @default(false)
  isFollowUpCorrect       Boolean?
  score                   Int      @default(0)
  maxScore                Int      @default(100)
  completedAt             DateTime @default(now())

  student  User                           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scenario MockInterviewRecruiterScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@index([studentId, completedAt])
  @@index([scenarioId])
}

model MockInterviewQuizAttempt {
  id             String   @id @default(cuid())
  studentId      String
  score          Int      @default(0)
  maxScore       Int      @default(180)
  percentage     Float    @default(0)
  totalQuestions Int      @default(0)
  correctAnswers Int      @default(0)
  userAnswers    Json     @default("{}")
  completedAt    DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, completedAt])
}

model BusinessPlan {
  id               String    @id @default(cuid())
  studentId        String
  instituteId      String
  title            String    @default("Untitled Business Plan")
  documentType     String    @default("BUSINESS_PLAN")
  status           String    @default("DRAFT")
  businessCategory String    @default("FOOD_BEVERAGE")
  data             Json
  templateId       String?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  student   User      @relation("StudentBusinessPlans", fields: [studentId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([studentId, updatedAt])
  @@index([instituteId])
}
