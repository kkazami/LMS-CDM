generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Institute {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  users          User[]
  courses        Course[]
  notes          Note[]
  taskItems      TaskItem[]
  calendarEvents CalendarEvent[]
}

model User {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password      String
  uniqueId      String   @default("")         // Employee ID or general identifier
  studentNumber String?                       // Regex pattern: /^\d{2}-\d{3}$/ (e.g., "24-101")
  role          String   @default("STUDENT")  // Roles: "STUDENT", "PROFESSOR" (alias: INSTRUCTOR), "ADMIN"
  isActive    Boolean  @default(true)
  permissions String   @default("[]")       // JSON array of permission strings
  instituteId String
  createdAt   DateTime @default(now())

  institute          Institute            @relation(fields: [instituteId], references: [id])
  sessions           Session[]
  notes              Note[]
  taskItems          TaskItem[]
  calendarEvents     CalendarEvent[]
  taughtCourses      Course[]             @relation("CourseInstructor")
  enrollments        Enrollment[]
  groupMemberships   StudentGroupMember[]
  announcements      Announcement[]
  sentComments       PrivateComment[]     @relation("CommentSender")
  receivedComments   PrivateComment[]     @relation("CommentRecipient")
  submissions        StudentSubmission[]
  dashboardLayouts   DashboardLayout[]
  auditLogsAsAdmin   AuditLog[]           @relation("AuditAdmin")
  auditLogsAsTarget  AuditLog[]           @relation("AuditTarget")
  passwordResetOtps  PasswordResetOtp[]
  // ─── Interactive Activities relations (Sprint 0) ───
  activityTemplates     ActivityTemplate[]    @relation("ActivityTemplateCreator")
  activitySubmissions   ActivitySubmission[]  @relation("ActivitySubmissions")
  activitySessions      ActivitySession[]     @relation("ActivitySessions")
  gamificationProfile   GamificationProfile?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id           String   @id @default(cuid())
  code         String                          // Course code like "CS101"
  courseCode   String   @unique @default("")   // 6-char alphanumeric join code (auto-generated)
  title        String
  section      String   @default("")
  subject      String   @default("")
  room         String   @default("")
  description  String   @default("")
  instructorId String?
  instituteId  String
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  institute        Institute          @relation(fields: [instituteId], references: [id])
  instructor       User?              @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  enrollments      Enrollment[]
  syllabusItems    SyllabusItem[]
  studentGroups    StudentGroup[]
  announcements    Announcement[]
  privateComments  PrivateComment[]
  taskItems        TaskItem[]
  calendarEvents   CalendarEvent[]
  dashboardLayouts DashboardLayout[]
  gradingPolicy    GradingPolicy?
  // ─── Interactive Activities relation (Sprint 0) ───
  activityTemplates ActivityTemplate[]
  weeklyChallenges  WeeklyChallenge[]
  leaderboardCaches ActivityLeaderboardCache[]

  @@index([instituteId])
  @@index([instructorId])
}

model Enrollment {
  id                String   @id @default(cuid())
  courseId          String
  studentId         String
  status            String   @default("PENDING") // PENDING | APPROVED | DECLINED
  displayOrderIndex Int      @default(0)
  createdAt         DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([courseId, status])
  @@index([studentId])
}

model SyllabusItem {
  id          String    @id @default(cuid())
  courseId    String
  type        String    @default("MATERIAL") // ASSIGNMENT | QUIZ | MATERIAL
  title       String
  description String    @default("")
  dueDate     DateTime?
  maxPoints   Int?
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  course       Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  targetGroups SyllabusTargetGroup[]
  attachments  Attachment[]
  submissions  StudentSubmission[]

  @@index([courseId, type])
  @@index([courseId, orderIndex])
}

model StudentGroup {
  id        String   @id @default(cuid())
  courseId   String
  groupName String
  createdAt DateTime @default(now())

  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members       StudentGroupMember[]
  targetedItems SyllabusTargetGroup[]

  @@index([courseId])
}

model StudentGroupMember {
  id        String @id @default(cuid())
  groupId   String
  studentId String

  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
}

model SyllabusTargetGroup {
  id             String @id @default(cuid())
  syllabusItemId String
  groupId        String

  syllabusItem SyllabusItem @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  group        StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([syllabusItemId, groupId])
}

model Announcement {
  id        String   @id @default(cuid())
  courseId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
}

model PrivateComment {
  id          String   @id @default(cuid())
  courseId     String
  senderId    String
  recipientId String
  content     String
  sentiment   String?  // Flagged sentiment: "positive" | "negative" | "neutral" | null
  createdAt   DateTime @default(now())

  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sender    User   @relation("CommentSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User   @relation("CommentRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([courseId, recipientId])
  @@index([senderId])
}

// ─── Phase 5–7 Models ───

model Attachment {
  id             String  @id @default(cuid())
  syllabusItemId String
  type           String  @default("FILE") // FILE | LINK
  url            String
  fileName       String  @default("")
  fileSize       Int?
  createdAt      DateTime @default(now())

  syllabusItem SyllabusItem @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)

  @@index([syllabusItemId])
}

model StudentSubmission {
  id             String    @id @default(cuid())
  syllabusItemId String
  studentId      String
  status         String    @default("DRAFT") // DRAFT | SUBMITTED | GRADED | RETURNED
  grade          Float?
  isReturned     Boolean   @default(false)
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  syllabusItem SyllabusItem          @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  student      User                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachments  SubmissionAttachment[]

  @@unique([syllabusItemId, studentId])
  @@index([syllabusItemId])
  @@index([studentId])
}

model SubmissionAttachment {
  id           String   @id @default(cuid())
  submissionId String
  type         String   @default("FILE") // FILE | LINK
  url          String
  fileName     String   @default("")
  createdAt    DateTime @default(now())

  submission StudentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model DashboardLayout {
  id                String   @id @default(cuid())
  userId            String
  courseId          String
  displayOrderIndex Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

// ─── Existing models below (unchanged) ───


model Note {
  id          String   @id @default(cuid())
  title       String   @default("")
  content     String   @default("")
  category    String   @default("General")
  color       String   @default("#ffffff")
  pinned      Boolean  @default(false)
  archived    Boolean  @default(false)
  orderIndex  Int      @default(0)
  creatorId   String
  instituteId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@index([instituteId, creatorId])
  @@index([instituteId, archived, pinned, orderIndex])
}

model TaskItem {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  priority    String    @default("medium")
  dueDate     DateTime?
  courseId     String?
  completed   Boolean   @default(false)
  archived    Boolean   @default(false)
  orderIndex  Int       @default(0)
  creatorId   String
  instituteId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([instituteId, creatorId])
  @@index([instituteId, completed, orderIndex])
}

model CalendarEvent {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  professorName String   @default("")
  maxPoints     Int?
  eventDate     DateTime
  eventType     String   @default("assignment")
  deepLink      String   @default("#")
  courseId       String?
  creatorId     String
  instituteId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([instituteId, eventDate])
  @@index([instituteId, creatorId])
}

model GradingPolicy {
  id        String   @id @default(cuid())
  courseId  String   @unique
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  weights   CategoryWeight[]
}

model CategoryWeight {
  id              String   @id @default(cuid())
  gradingPolicyId String
  category        String   // Matches SystemClassworkType (e.g., ASSIGNMENT, QUIZ, or custom)
  weightPercentage Float
  
  gradingPolicy   GradingPolicy @relation(fields: [gradingPolicyId], references: [id], onDelete: Cascade)

  @@unique([gradingPolicyId, category])
}

// ─── Admin & Audit Models ───

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  targetId  String
  action    String   // e.g., 'ROLE_CHANGE_TO_INSTRUCTOR', 'ACCOUNT_SUSPENSION'
  ipAddress String   @default("")
  metadata  String   @default("{}") // JSON for additional context
  createdAt DateTime @default(now())

  admin  User @relation("AuditAdmin", fields: [adminId], references: [id])
  target User @relation("AuditTarget", fields: [targetId], references: [id])

  @@index([adminId])
  @@index([targetId])
  @@index([createdAt])
}

model PasswordResetOtp {
  id          String   @id @default(cuid())
  userId      String
  otpCodeHash String
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Interactive Activities Models (Sprint 0) ───
// These tables support the ICS-exclusive Interactive Activities feature suite:
// 3D hardware simulations (PC building, Arduino/IoT, server racks, logic gates)
// and the multi-language auto-graded CodeLab.

/// Instructor-defined problem template that drives activity randomization.
/// Each template defines a "problem shape" with variables substituted per-student.
model ActivityTemplate {
  id           String   @id @default(cuid())
  activityType String                          // "pc-build" | "arduino" | "server-rack" | "logic-gate" | "codelab"
  title        String   @default("Interactive Activity")
  courseId     String
  syllabusItemId String?
  difficulty   Int      @default(1)            // 1 = introductory, 2 = intermediate, 3 = advanced
  variables    String   @default("{}")         // JSON: placeholder variables for randomization
  faultPool    String   @default("[]")         // JSON array: fault IDs for troubleshooting activities
  hiddenTestCases String @default("[]")        // JSON array: hidden test cases for CodeLab
  createdBy    String                          // Instructor user ID
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator      User     @relation("ActivityTemplateCreator", fields: [createdBy], references: [id])
  submissions  ActivitySubmission[]
  sessions     ActivitySession[]
  weeklyChallenges WeeklyChallenge[]

  @@index([courseId, activityType])
  @@index([createdBy])
}

/// Student submission record for a completed activity attempt.
/// Contains the full grading payload so the activity can be graded
/// without replaying the 3D scene.
model ActivitySubmission {
  id                    String   @id @default(cuid())
  studentId             String
  templateId            String
  activityType          String                          // Denormalized from template for query convenience
  variantSeed           String                          // Deterministic seed for reproducible grading
  startedAt             DateTime
  completionTimeSeconds Int
  attempts              Int      @default(1)
  stateCheck            String   @default("{}")         // JSON: activity-specific key-value state
  score                 Float    @default(0)            // 0–100
  maxScore              Float    @default(100)
  passed                Boolean  @default(false)
  errorLog              String   @default("[]")         // JSON array: student-visible diagnostic hints
  submittedAt           DateTime @default(now())

  student  User              @relation("ActivitySubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  template ActivityTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([studentId, activityType])
  @@index([templateId])
  @@index([submittedAt])
}

/// Registry of 3D model assets used by activity modules.
/// Tracks paths, versions, and Draco compression status.
model ActivityAsset {
  id                String   @id @default(cuid())
  path              String   @unique                    // Path relative to public/models/
  name              String                              // Human-readable asset name
  version           String   @default("1.0.0")
  isDracoCompressed Boolean  @default(true)
  activityTypes     String   @default("[]")             // JSON array of activity type strings
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

/// Tracks an in-progress activity attempt before submission.
/// Created when a student opens an activity, finalized on submit or timeout.
model ActivitySession {
  id          String   @id @default(cuid())
  studentId   String
  templateId  String
  variantSeed String
  status      String   @default("in_progress")          // "in_progress" | "submitted" | "timed_out" | "abandoned"
  startedAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  student  User             @relation("ActivitySessions", fields: [studentId], references: [id], onDelete: Cascade)
  template ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([templateId])
}

// ─── Interactive Activities Gamification (Sprint 7) ───

model GamificationProfile {
  id                    String   @id @default(cuid())
  studentId             String   @unique
  currentStreak         Int      @default(0)
  longestStreak         Int      @default(0)
  lastActivityDate      DateTime?
  totalPoints           Int      @default(0)
  isLeaderboardAnonymized Boolean @default(true) // Privacy default: opt-in to public
  student               User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badges                StudentBadge[]
}

model StudentBadge {
  id          String   @id @default(cuid())
  profileId   String
  badgeRuleId String
  earnedAt    DateTime @default(now())

  profile   GamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  @@unique([profileId, badgeRuleId])
}

model ActivityLeaderboardCache {
  id           String   @id @default(cuid())
  courseId     String?  // null means global institute leaderboard
  activityType String?  // null means overall points across all activities
  rankings     String   @default("[]") // JSON string of { studentId, displayName, points }
  updatedAt    DateTime @default(now()) @updatedAt

  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, activityType])
}

model WeeklyChallenge {
  id         String   @id @default(cuid())
  courseId   String
  templateId String
  startDate  DateTime
  endDate    DateTime
  isOptIn    Boolean  @default(true)
  
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  template   ActivityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}