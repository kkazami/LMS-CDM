  program        AcademicProgram        @relation(fields: [programId, instituteId], references: [id, instituteId], onDelete: Restrict)
  user           User                   @relation(fields: [userId, instituteId], references: [id, instituteId], onDelete: Restrict)
  headAssignment ProgramHeadAssignment?
