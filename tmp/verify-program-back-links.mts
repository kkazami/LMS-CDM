import fs from 'node:fs';
import path from 'node:path';
import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { chromium } from 'playwright';
import ProgramBackLinkModule from '../apps/web/src/components/academic-structure/ProgramBackLink';
const ProgramBackLink = (ProgramBackLinkModule as { default?: unknown }).default ?? ProgramBackLinkModule;
const requireWeb = createRequire(path.resolve('apps/web/package.json'));
const React = requireWeb('react');
Object.assign(globalThis, { React });
const { renderToStaticMarkup } = requireWeb('react-dom/server');
const postcss = requireWeb('postcss');
const tailwind = requireWeb('@tailwindcss/postcss');
const css = (await postcss([tailwind({base:path.resolve('apps/web')})]).process('@import "tailwindcss";', {from:path.resolve('apps/web/src/app/back-link-preview.css')})).css;
const markup = ['/ics/organization/program/instructors','/ics/organization'].map((href,index) => renderToStaticMarkup(React.createElement(ProgramBackLink,{href},index?'Back to Program Chart':'Back to Program Instructors'))).join('<br><br>');
const browser = await chromium.launch({executablePath:'C:/Program Files/Google/Chrome/Application/chrome.exe',headless:true});
const page = await browser.newPage({viewport:{width:1000,height:360}});
const output=path.resolve('tmp/program-back-link-preview');fs.mkdirSync(output,{recursive:true});
try {
 await page.setContent(`<style>${css}</style><main style="padding:32px;font-family:Arial,sans-serif;background:#f8fafc;min-height:100vh">${markup}</main>`);
 const link=page.getByRole('link',{name:'Back to Program Instructors',exact:true});
 assert.equal(await link.getAttribute('href'),'/ics/organization/program/instructors');
 assert.ok((await link.boundingBox())!.height>=44);
 await page.keyboard.press('Tab');
 assert.equal(await link.evaluate(el=>document.activeElement===el),true);
 assert.equal(await link.evaluate(el=>getComputedStyle(el).outlineStyle),'solid');
 await link.hover();
 await page.screenshot({path:path.join(output,'desktop.png')});
 await page.setViewportSize({width:390,height:360});
 await page.screenshot({path:path.join(output,'mobile.png')});
 assert.ok((await link.boundingBox())!.width<=390-64);
 await page.emulateMedia({reducedMotion:'reduce'});
 assert.equal(await link.locator('svg').evaluate(el=>getComputedStyle(el).transform),'none');
 assert.equal(await link.locator('svg').evaluate(el=>getComputedStyle(el).transitionProperty),'none');
 await page.emulateMedia({colorScheme:'dark',reducedMotion:'reduce'});
 await page.locator('main').evaluate(el=>el.style.background='#0f172a');
 await page.screenshot({path:path.join(output,'dark-mobile.png')});
 console.log('PASS: destinations, 44px target, keyboard focus, responsive sizing, reduced motion; desktop/mobile/dark previews saved.');
} finally {await browser.close();}
