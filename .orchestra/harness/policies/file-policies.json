{
  "version": 2,
  "enforcement": "Host sandbox required; controller additionally checks source deltas and manifests",
  "secretReads": "deny; only runner/host inject disposable credentials",
  "executor": {
    "allowed": "Exact reviewed plan paths",
    "forbidden": [
      "secret files",
      "test-author files",
      "run artifacts",
      "harness controls in product runs"
    ]
  },
  "test": {
    "allowed": [
      "tests/**",
      "playwright/**",
      "playwright.config.ts"
    ],
    "forbidden": [
      "product files",
      "harness controls",
      "secret files"
    ]
  },
  "reviewers": {
    "source": "read-only",
    "outputs": "Only own controller-submitted artifact"
  },
  "controller": {
    "owns": [
      ".orchestra/runs/**"
    ],
    "agentsMayWrite": false
  },
  "harnessMaintenance": {
    "requires": "Explicit harness scope and signed HIGH/CRITICAL approval; product/Prisma files forbidden"
  }
}
