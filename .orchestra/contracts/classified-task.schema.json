{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Classified Task v2 (classification proposal; controller owns risk floor)",
  "type": "object",
  "required": [
    "id",
    "prompt",
    "intent",
    "domain",
    "risk",
    "requiresBrowserVerification",
    "harnessProfile",
    "qualityLevel"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "intent": {
      "enum": [
        "feature",
        "bug_fix",
        "refactor",
        "testing",
        "documentation",
        "security",
        "deployment",
        "harness"
      ]
    },
    "domain": {
      "enum": [
        "frontend",
        "backend",
        "api",
        "database",
        "mobile",
        "fullstack",
        "devops",
        "harness"
      ]
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "requiresBrowserVerification": {
      "type": "boolean"
    },
    "harnessProfile": {
      "enum": [
        "frontend",
        "api",
        "database",
        "fullstack",
        "mobile",
        "bugfix",
        "refactor",
        "harness",
        "desktop"
      ]
    },
    "qualityLevel": {
      "enum": [
        "standard",
        "strict",
        "maximum"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
