# Public web/API origin only. Never put database, SMTP, or provider secrets here.
EXPO_PUBLIC_API_URL=https://lms-cdm.vercel.app

# Optional public monitoring DSN; server-side source-map credentials belong in EAS.
EXPO_PUBLIC_SENTRY_DSN=
# Optional UI rollback switches. Data-isolation and contract repairs are always on.
EXPO_PUBLIC_ICS_HOME_V2=true
EXPO_PUBLIC_ICS_ASSESSMENTS_ENABLED=true
# Keep false until the remote push delivery pipeline has been provisioned.
EXPO_PUBLIC_REMOTE_PUSH_ENABLED=false

# For local development with pnpm dev:web on the same network, use:
# EXPO_PUBLIC_API_URL=auto
# Or specify a reachable backend URL. The API origin must not include /login.
# Restart Expo with --clear after changing this file's local copy.
