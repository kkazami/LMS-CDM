{
  "expo": {
    "name": "Lumina LMS",
    "slug": "lumina-lms",
    "scheme": "lumina-lms",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.lumina.lms",
      "supportsTablet": true
    },
    "android": {
      "package": "com.lumina.lms"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image"
    ]
  }
}
