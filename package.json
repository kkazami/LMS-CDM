{
  "name": "cdm-lms",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:setup": "node scripts/check-local-setup.mjs",
    "dev:web": "node scripts/check-local-setup.mjs web && node scripts/start-local-scanner.mjs --if-configured && pnpm --filter web dev",
    "scanner:start": "node scripts/start-local-scanner.mjs",
    "dev:mobile": "node scripts/check-local-setup.mjs mobile && pnpm --filter mobile start",
    "dev:mobile:clear": "node scripts/check-local-setup.mjs mobile && pnpm --filter mobile start --clear",
    "dev:mobile:tunnel": "node scripts/check-local-setup.mjs mobile && pnpm --filter mobile tunnel",
    "dev:mobile:usb": "node scripts/check-local-setup.mjs mobile && adb reverse tcp:8081 tcp:8081 && pnpm --filter mobile start --localhost --port 8081",
    "dev:desktop": "node scripts/check-local-setup.mjs desktop && pnpm --filter desktop dev",
    "dev:all": "turbo dev start --parallel",
    "build:web": "prisma generate && pnpm --filter web build",
    "build:mobile": "pnpm --filter mobile build",
    "build:desktop": "pnpm --filter desktop build",
    "postinstall": "prisma generate",
    "harness:check": "tsx scripts/harness-check.ts",
    "harness:verify": "tsx scripts/harness-verify-run.ts",
    "test:unit": "pnpm --filter web run test:unit",
    "harness": "tsx scripts/harness-cli.ts",
    "harness:test": "node --import tsx --test --test-reporter ./scripts/harness/test-reporter.cjs tests/harness/*.test.ts",
    "harness:typecheck": "pnpm --filter web exec tsc --project ../../scripts/harness/tsconfig.json",
    "harness:host": "tsx scripts/harness-host.ts",
    "harness:smoke": "tsx scripts/harness-smoke.ts",
    "harness:key": "tsx scripts/harness-key.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report playwright/report",
    "test:labs": "node --import tsx --test tests/labs/schema.test.ts tests/labs/presets.test.ts tests/labs/resources.test.ts tests/labs/transport.test.cjs",
    "test:labs:integration": "node tests/labs/integration.mjs",
    "test:gradebook": "node --import tsx --test tests/gradebook/*.test.ts",
    "test:gradebook:integration": "node tests/gradebook/integration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.21.0",
    "playwright": "^1.63.0",
    "prisma": "^7.9.1",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.4.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
