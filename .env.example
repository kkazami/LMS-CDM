# Database Connection String
# PostgreSQL only. Supply the restricted application principal after boundary setup.
DATABASE_URL="postgresql://lms_app:replace-me@localhost:5432/lms"
# Optional: 1..20 connections PER PROCESS. Defaults: production 2, development 15.
# Set only after budgeting all app instances + workers + operator headroom against the provider/pooler limit.
# DATABASE_POOL_MAX=2

# Public API Base URL for Web App
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"CdM LMS Admin" <your-email@gmail.com>'

# AI Harness — LLM-as-Judge (Gemini or Agent Router / DeepSeek)
GEMINI_API_KEY=""
AGENT_ROUTER_API_KEY="your-agent-router-api-key"

# E2E Testing (Playwright) — override for non-default test environments
# These default to the seeded dev accounts if not set.
# NEVER use production credentials.
# E2E_BASE_URL="http://localhost:3000"
# E2E_INSTITUTE="ics"
# E2E_STUDENT_EMAIL="student@ics.edu.ph"
# E2E_STUDENT_PASSWORD="password123"
# E2E_INSTRUCTOR_EMAIL="instructor@ics.edu.ph"
# E2E_INSTRUCTOR_PASSWORD="password123"
# E2E_ADMIN_EMAIL="admin@ics.edu.ph"
# E2E_ADMIN_PASSWORD="password123"


# Roster invitations (server-only; replace the previously shared app password)
APP_BASE_URL="http://localhost:3000"
CRON_SECRET=""
EMAIL_INVITATIONS_ENABLED="false"
EMAIL_DAILY_LIMIT="400"
# Explicit operator-only reconciliation target; never expose to clients
# ROSTER_DATABASE_URL="postgresql://operator:password@localhost:5432/lms"

# Sprint 1: configure secrets explicitly; see docs/quality/sprint-1-deployment.md
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_PREVIOUS_KEYS=
GITHUB_WEBHOOK_SECRET=
ATTACHMENT_STORAGE_HOSTS=

# Sprint 2: trusted private-network clamd endpoint; no upload bypass when unset/offline
# Configure clamd StreamMaxLength >= 25 MB. Never expose this port publicly.
CLAMAV_HOST=
CLAMAV_PORT=

# Managed CodeLab execution; server-only, never NEXT_PUBLIC_*. No public-demo fallback.
# Official managed Judge0 CE via RapidAPI: set this key; JUDGE0_URL may remain empty.
JUDGE0_RAPIDAPI_KEY=
# Or an explicitly reviewed Judge0-compatible managed HTTPS origin plus its token:
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
