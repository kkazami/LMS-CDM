# Database Connection String
# For local SQLite: file:./dev.db
# For production (Vercel Postgres / Supabase / Neon): postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Public API Base URL for Web App
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"CdM LMS Admin" <your-email@gmail.com>'

# AI Harness — LLM-as-Judge (Gemini or Agent Router / DeepSeek)
GEMINI_API_KEY="your-gemini-api-key"
AGENT_ROUTER_API_KEY="your-agent-router-api-key"

