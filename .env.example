# Database Connection String
# PostgreSQL only. Supply the restricted application principal after boundary setup.
DATABASE_URL="postgresql://lms_app:replace-me@localhost:5432/lms"

# Public API Base URL for Web App
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM='"CdM LMS Admin" <your-email@gmail.com>'

# AI Harness — LLM-as-Judge (Gemini or Agent Router / DeepSeek)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
AGENT_ROUTER_API_KEY="your-agent-router-api-key"

# Groq Fallback AI Provider (used automatically when Gemini fails)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# E2E Testing (Playwright) — override for non-default test environments
# These default to the seeded dev accounts if not set.
# NEVER use production credentials.
# E2E_BASE_URL="http://localhost:3000"
# E2E_INSTITUTE="ics"
# E2E_STUDENT_EMAIL="student@ics.edu.ph"
# E2E_STUDENT_PASSWORD="password123"
# E2E_INSTRUCTOR_EMAIL="instructor@ics.edu.ph"
# E2E_INSTRUCTOR_PASSWORD="password123"
# E2E_ADMIN_EMAIL="admin@ics.edu.ph"
# E2E_ADMIN_PASSWORD="password123"

# Cron Secret for automated cron tasks
CRON_SECRET=""

# Roster invitations (server-only; replace the previously shared app password)
APP_BASE_URL="http://localhost:3000"
EMAIL_INVITATIONS_ENABLED="false"
EMAIL_DAILY_LIMIT="400"
# Explicit operator-only reconciliation target; never expose to clients
# ROSTER_DATABASE_URL="postgresql://operator:password@localhost:5432/lms"
